# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# This is the only value that changes between environments.
#
# Local / self-hosted (matches docker-compose.yml):
DATABASE_URL="postgresql://adeyanju:adeyanju_dev_password@localhost:5432/adeyanju_cms"
#
# Neon on Vercel — use the POOLED connection string ("-pooler" in the host):
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# TLS is enabled automatically for any non-local host. Set this only if you are
# running a remote database without TLS:
# DATABASE_SSL="disable"

# Credentials used by docker-compose.yml when it creates the container.
POSTGRES_USER="adeyanju"
POSTGRES_PASSWORD="adeyanju_dev_password"
POSTGRES_DB="adeyanju_cms"
POSTGRES_PORT="5432"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# Changing it signs every logged-in user out.
AUTH_SECRET="replace-me-with-a-32-character-random-string"

# ---------------------------------------------------------------------------
# First administrator (read by `npm run db:seed` only)
# ---------------------------------------------------------------------------
# Remove these after seeding — further accounts are created inside the CMS.
ADMIN_EMAIL="test@gbb.gov.ng"
ADMIN_NAME="Galaxy Backbone Media Team"
ADMIN_PASSWORD="change-this-password-1"

# ---------------------------------------------------------------------------
# Search engines
# ---------------------------------------------------------------------------
# The public address. Canonical links, the sitemap and sharing cards are built
# from it. Defaults to https://www.ibrahimadeyanju.com when not set.
# NEXT_PUBLIC_SITE_URL="https://www.ibrahimadeyanju.com"
#
# Only if you verify the site in Google Search Console with the "HTML tag"
# method: the code it gives you. The DNS method needs nothing here.
# GOOGLE_SITE_VERIFICATION=""
